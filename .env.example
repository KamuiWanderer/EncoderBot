# Telegram Video Encoder Bot Configuration

# Telegram Bot API credentials (from https://my.telegram.org)
API_ID=
API_HASH=

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=

# Authorized Owner Telegram User IDs (comma-separated if multiple, e.g. 123456789,987654321)
OWNER_IDS=

# Storage path (optional, defaults to ./storage)
STORAGE_DIR=./storage

# Database path (optional, defaults to ./storage/encoder_bot.db)
DATABASE_PATH=./storage/encoder_bot.db

# FFmpeg execution settings
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# Max concurrent encodes (default 1 for safety on laptops/mobile)
MAX_CONCURRENT_ENCODES=1

# Default encoding preset (ultrafast, superfast, veryfast, faster, fast, medium, slow)
DEFAULT_PRESET=medium

# Disk Space Safety threshold in Gigabytes (refuse new jobs if free space is below this)
MIN_FREE_DISK_GB=2.0
